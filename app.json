{
  "expo": {
    "name": "Buch",
    "slug": "buch-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "buch",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.buch.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Buch verwendet die Kamera, um Seiten deiner eigenen Bücher einzuscannen.",
        "NSPhotoLibraryUsageDescription": "Buch benötigt Zugriff auf deine Fotos, um gescannte Seiten zu importieren."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.buch.app",
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Buch verwendet die Kamera, um Seiten deiner eigenen Bücher einzuscannen."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Buch benötigt Zugriff auf deine Fotos, um gescannte Seiten zu importieren."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
